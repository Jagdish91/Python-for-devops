import requests
from requests.auth import HTTPBasicAuth
import json

# ----------- CHANGE THESE VALUES ------------

JIRA_URL = "$1"
EMAIL = "$2"
API_TOKEN = "$3"

PROJECT_KEY = "PROJ"          # Example: DEV, TEST
ISSUE_TYPE = "Task"          # Task/Bug/Story
SUMMARY = "My first Jira ticket from Python"
DESCRIPTION = "This ticket was created using Python script."

# --------------------------------------------

# Jira API URL
url = f"{JIRA_URL}/rest/api/3/issue"

# Authentication
auth = HTTPBasicAuth(EMAIL, API_TOKEN)

# Data we want to send to Jira
payload = {
    "fields": {
        "project": {
            "key": PROJECT_KEY
        },
        "summary": SUMMARY,
        "description": {
            "type": "doc",
            "version": 1,
            "content": [{
                "type": "paragraph",
                "content": [{
                    "type": "text",
                    "text": DESCRIPTION
                }]
            }]
        },
        "issuetype": {
            "name": ISSUE_TYPE
        }
    }
}

# Headers
headers = {
    "Accept": "application/json",
    "Content-Type": "application/json"
}

# Send request
response = requests.post(
    url,
    headers=headers,
    auth=auth,
    json=payload
)

# Show result
if response.status_code == 201:
    print("✅ Ticket created successfully!")
    print(json.dumps(response.json(), indent=4))
else:
    print("❌ Something went wrong")
    print("Status Code:", response.status_code)
    print(response.text)
